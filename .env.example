# Server-side ONLY — NEVER prefix with NEXT_PUBLIC_
# Paste your temporary aiesec_token from EXPA Local Storage (or approved Developer App token)
EXPA_ACCESS_TOKEN=

# AIESEC GIS GraphQL Endpoint (Production default; switch to https://staging-jruby.aiesec.org/graphql for staging)
EXPA_GRAPHQL_URL=https://gis-api.aiesec.org/graphql

# Default Office ID to display on initial load (6 = AIESEC in UNS, 1539 = MC Indonesia)
DEFAULT_OFFICE_ID=6
DEFAULT_OFFICE_NAME=AIESEC in UNS
